services:
  backend:
    build:
      context: ./backend
    container_name: ecommerce-api
    env_file:
      - ./backend/.env.docker
    ports:
      - "8000:8000"
    extra_hosts:
      - "host.docker.internal:host-gateway"

  frontend:
    build:
      context: ./frontend
    container_name: ecommerce-frontend
    env_file:
      - ./frontend/.env.docker
    ports:
      - "3000:3000"
    depends_on:
      backend:
        condition: service_healthy
